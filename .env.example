# =============================================================
# EleitoWatch — Exemplo de variáveis de ambiente
# Copie para `.env.local` e preencha com as credenciais reais.
#   cp .env.example .env.local
# NUNCA commite o `.env.local` (já está no .gitignore).
# =============================================================


# ── 1. FRONTEND (Vite) ────────────────────────────────────────
# Expostas no bundle do navegador. Use SOMENTE chaves públicas.
# Onde achar: Supabase Dashboard > Project Settings > API
# -------------------------------------------------------------

# URL do projeto Supabase (ex.: https://abcdefghijklmno.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" / "publishable" (respeita RLS)
VITE_SUPABASE_ANON_KEY=


# ── 2. ADMINISTRAÇÃO DO BANCO (CLI / migrations) ──────────────
# Usadas só localmente e em CI. NUNCA prefixar com VITE_
# (qualquer variável VITE_ vaza para o navegador).
# -------------------------------------------------------------

# Referência do projeto — o subdomínio da URL acima
# Onde achar: Project Settings > General > Reference ID
SUPABASE_PROJECT_REF=

# Token pessoal de acesso da CLI (para `supabase link` / `db push`)
# Onde achar: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Senha do banco (definida na criação do projeto; pode ser resetada)
# Onde achar: Project Settings > Database > Database password
SUPABASE_DB_PASSWORD=

# String de conexão direta — usada para aplicar DDL (CREATE TABLE/ALTER TABLE)
# e rodar scripts de migração via psql.
# Onde achar: Project Settings > Database > Connection string > URI
# Prefira o pooler na porta 6543 para scripts; 5432 para migrations.
# Formato: postgresql://postgres.<ref>:<senha>@<host>:5432/postgres
SUPABASE_DB_URL=


# ── 3. SERVIÇO / EDGE FUNCTIONS ───────────────────────────────
# A chave service_role ignora TODAS as políticas de RLS.
# Só pode existir no servidor, em secrets ou no seu .env.local.
# Em produção a Edge Function já recebe SUPABASE_URL e
# SUPABASE_SERVICE_ROLE_KEY injetadas pelo runtime — preencha
# aqui apenas para rodar/testar localmente e para scripts de seed.
# Onde achar: Project Settings > API > service_role secret
# -------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=


# ── 4. OPCIONAIS / INTEGRAÇÕES ────────────────────────────────

# URL do CSV de locais de votação do TRE-PI usado pela função
# `sync-tre-pi-ckan`. Deixe em branco para usar o valor padrão
# já embutido no código.
TRE_PI_CSV_URL=
